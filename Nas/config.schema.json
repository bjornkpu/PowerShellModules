{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Nas Module Configuration",
    "description": "Configuration for NAS server SMB access",
    "type": "object",
    "required": ["hostname", "username", "password", "shares"],
    "additionalProperties": false,
    "properties": {
        "hostname": {
            "type": "string",
            "description": "NAS server hostname or IP address",
            "pattern": "^(?!<).*(?<!>)$",
            "minLength": 1
        },
        "username": {
            "type": "string",
            "description": "SMB username",
            "pattern": "^(?!<).*(?<!>)$",
            "minLength": 1
        },
        "password": {
            "type": "string",
            "description": "SMB password",
            "pattern": "^(?!<).*(?<!>)$",
            "minLength": 1
        },
        "shares": {
            "type": "array",
            "description": "SMB shares to mount",
            "items": {
                "type": "object",
                "required": ["name", "driveLetter"],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Share name on the NAS",
                        "minLength": 1
                    },
                    "driveLetter": {
                        "type": "string",
                        "description": "Drive letter to mount to (single uppercase letter)",
                        "pattern": "^[A-Z]$"
                    }
                }
            }
        }
    }
}
