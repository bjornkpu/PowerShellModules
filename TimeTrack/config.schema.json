{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "activeSource",
        "sources",
        "lunch",
        "targets"
    ],
    "properties": {
        "activeSource": {
            "type": "string",
            "description": "Which source to use (must match a key in 'sources')"
        },
        "sources": {
            "type": "object",
            "description": "Named time tracking provider configurations",
            "additionalProperties": false,
            "properties": {
                "toggl": {
                    "type": "object",
                    "required": [
                        "apiToken",
                        "workspaceId"
                    ],
                    "properties": {
                        "apiToken": {
                            "type": "string",
                            "pattern": "^(?!<).*(?<!>)$",
                            "minLength": 32,
                            "description": "Toggl Track API token (get from https://track.toggl.com/profile)"
                        },
                        "workspaceId": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Toggl workspace ID (numeric)"
                        }
                    }
                },
                "solidtime": {
                    "type": "object",
                    "required": [
                        "baseUrl",
                        "organizationId",
                        "memberId",
                        "apiKey"
                    ],
                    "properties": {
                        "baseUrl": {
                            "type": "string",
                            "format": "uri",
                            "description": "Solidtime instance base URL"
                        },
                        "organizationId": {
                            "type": "string",
                            "pattern": "^(?!<).*(?<!>)$",
                            "description": "Solidtime organization ID"
                        },
                        "memberId": {
                            "type": "string",
                            "pattern": "^(?!<).*(?<!>)$",
                            "description": "Solidtime member ID (from /users/me/memberships)"
                        },
                        "apiKey": {
                            "type": "string",
                            "pattern": "^(?!<).*(?<!>)$",
                            "description": "Solidtime API key"
                        }
                    }
                },
                "mock": {
                    "type": "object",
                    "properties": {
                        "workspaceId": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                },
                "fixtures": {
                    "type": "object"
                }
            }
        },
        "lunch": {
            "type": "object",
            "required": [
                "client",
                "project"
            ],
            "properties": {
                "client": {
                    "type": "string",
                    "pattern": "^(?!<).*(?<!>)$",
                    "description": "Client name for lunch entries (e.g., 'Punsvik')"
                },
                "project": {
                    "type": "string",
                    "pattern": "^(?!<).*(?<!>)$",
                    "description": "Project name for lunch entries (e.g., 'Lunsj')"
                },
                "timezone": {
                    "type": "string",
                    "pattern": "^(?!<).*(?<!>)$",
                    "description": "IANA timezone for lunch scheduling (e.g., 'Europe/Oslo'). Defaults to 'Europe/Oslo'.",
                    "default": "Europe/Oslo"
                }
            }
        },
        "targets": {
            "type": "object",
            "description": "Reporting targets (timesheet systems)",
            "additionalProperties": {
                "type": "object",
                "required": [
                    "enabled",
                    "company",
                    "system",
                    "rounding",
                    "projectMappings"
                ],
                "properties": {
                    "enabled": {
                        "type": "boolean",
                        "description": "Whether this target is enabled"
                    },
                    "company": {
                        "type": "string",
                        "description": "Company name for this target"
                    },
                    "system": {
                        "type": "string",
                        "description": "System name (e.g., 'TimeReg', 'xLedger')"
                    },
                    "rounding": {
                        "type": "number",
                        "minimum": 0.01,
                        "default": 0.5,
                        "description": "Round hours to nearest increment (e.g., 0.5 for 30min, 0.25 for 15min)"
                    },
                    "projectMappings": {
                        "type": "object",
                        "description": "Map source project names to target project names/codes",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}