{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "databricks": {
            "type": "object",
            "properties": {
                "host": {
                    "type": "string",
                    "description": "Databricks workspace URL (e.g., https://your-workspace.azuredatabricks.net)",
                    "pattern": "^https://.*\\.azuredatabricks\\.net$",
                    "minLength": 1
                },
                "accountId": {
                    "type": "string",
                    "description": "Your Databricks account email address",
                    "pattern": "^(?!<).*@.*\\..*(?<!>)$",
                    "minLength": 1
                },
                "clusterId": {
                    "type": "string",
                    "description": "Default cluster ID (e.g., 0904-090205-7bmqua3s)",
                    "pattern": "^(?!<)[0-9]{4}-[0-9]{6}-[a-z0-9]+(?<!>)$",
                    "minLength": 1
                },
                "workspacePath": {
                    "type": "string",
                    "description": "Local path to your Python package workspace (e.g., C:\\repos\\your-project)",
                    "pattern": "^(?!<).*(?<!>)$",
                    "minLength": 1
                },
                "defaultPackage": {
                    "type": "string",
                    "description": "Default Python package name to deploy",
                    "pattern": "^(?!<)[a-zA-Z0-9_-]+(?<!>)$",
                    "minLength": 1
                },
                "profile": {
                    "type": "string",
                    "description": "Databricks CLI profile name",
                    "pattern": "^(?!<).*(?<!>)$",
                    "default": "DEFAULT"
                },
                "keepAliveIntervalMinutes": {
                    "type": "integer",
                    "description": "Keep-alive interval in minutes (default: 30)",
                    "minimum": 5,
                    "maximum": 39,
                    "default": 30
                },
                "environments": {
                    "type": "object",
                    "description": "Environment-specific configurations (e.g., dev, prod)",
                    "patternProperties": {
                        "^[a-zA-Z0-9_-]+$": {
                            "type": "object",
                            "properties": {
                                "profile": {
                                    "type": "string",
                                    "description": "Databricks CLI profile name for this environment",
                                    "pattern": "^(?!<).*(?<!>)$",
                                    "minLength": 1
                                },
                                "host": {
                                    "type": "string",
                                    "description": "Databricks workspace URL for this environment",
                                    "pattern": "^https://.*\\.azuredatabricks\\.net$",
                                    "minLength": 1
                                },
                                "clusterId": {
                                    "type": "string",
                                    "description": "Cluster ID for this environment",
                                    "pattern": "^(?!<)[0-9]{4}-[0-9]{6}-[a-z0-9]+(?<!>)$",
                                    "minLength": 1
                                }
                            },
                            "required": [
                                "profile",
                                "host",
                                "clusterId"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "host",
                "accountId",
                "clusterId",
                "workspacePath",
                "defaultPackage"
            ],
            "additionalProperties": false
        },
        "azureDevOps": {
            "type": "object",
            "properties": {
                "organization": {
                    "type": "string",
                    "description": "Azure DevOps organization name (e.g., myorg)",
                    "pattern": "^(?!<).*(?<!>)$",
                    "minLength": 1
                },
                "project": {
                    "type": "string",
                    "description": "Azure DevOps project name (e.g., MyProject)",
                    "pattern": "^(?!<).*(?<!>)$",
                    "minLength": 1
                },
                "areaPath": {
                    "type": "string",
                    "description": "Work item area path (e.g., MyProject\\Data Pipeline)",
                    "pattern": "^(?!<).*(?<!>)$",
                    "minLength": 1
                },
                "iterationPath": {
                    "type": "string",
                    "description": "Work item iteration path (e.g., MyProject\\Sprint 1)",
                    "pattern": "^(?!<).*(?<!>)$"
                },
                "workItemMapping": {
                    "type": "object",
                    "description": "Map Databricks run states to Azure DevOps work item types",
                    "properties": {
                        "FAILED": {
                            "type": "string",
                            "enum": [
                                "Bug",
                                "Issue",
                                "User Story",
                                "Task"
                            ]
                        },
                        "TIMEDOUT": {
                            "type": "string",
                            "enum": [
                                "Bug",
                                "Issue",
                                "User Story",
                                "Task"
                            ]
                        },
                        "CANCELED": {
                            "type": "string",
                            "enum": [
                                "Bug",
                                "Issue",
                                "User Story",
                                "Task"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "tags": {
                    "type": "array",
                    "description": "Additional tags to add to work items",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "databricks",
                        "automated"
                    ]
                },
                "parentWorkItemId": {
                    "type": "integer",
                    "description": "Optional parent work item ID to link created work items to (e.g., 18213)",
                    "minimum": 1
                }
            },
            "required": [
                "organization",
                "project",
                "areaPath",
                "workItemMapping",
                "parentWorkItemId"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "databricks"
    ],
    "additionalProperties": false
}